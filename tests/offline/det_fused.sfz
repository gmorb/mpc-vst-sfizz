// As det.sfz, without pan modulation and with an amplitude CC: takes the one-pass amplitude/pan paths on ARM.
<control> hint_ram_based=1 set_cc10=64 set_cc7=90 default_path=Samples/
<global> amplitude_oncc7=100 amplitude_curvecc7=4 amp_veltrack=0 ampeg_release=0.3
<region> sample=C4v8.flac lokey=50 hikey=70 pitch_keycenter=60 pan=40
<region> sample=A0v8.flac lokey=21 hikey=49 pitch_keycenter=33
<region> sample=C7v8.flac lokey=71 hikey=108 pitch_keycenter=96 width=60 position=-30
