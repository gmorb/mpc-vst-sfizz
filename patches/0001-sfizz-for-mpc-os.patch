+struct sfz::FilePool::GentleStream {
+    std::weak_ptr<FileId> id;
+    FileData* data { nullptr };
+    AudioReaderPtr reader;
+    size_t numFrames { 0 };
+    unsigned numChannels { 0 };
+    size_t out { 0 };          // frames decoded into data->fileData
